/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; form-action 'self' https://www.billplz.com https://www.billplz-sandbox.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

# Notes on the CSP above — each relaxation is deliberate:
#   'unsafe-inline' for style — Tailwind and React inject inline styles for the
#       carousel transform and the progress bars. Removing it needs nonces,
#       which a statically exported site cannot mint per request.
#   'unsafe-inline' for script — Next.js inlines its hydration bootstrap.
#   form-action includes Billplz because paying online navigates there.
#   frame-ancestors 'none' + X-Frame-Options: DENY — the shop must never be
#       framed; that is how a fake checkout gets built on top of a real one.
#   connect-src 'self' — the browser talks only to this origin's /api.

# The admin passcode screen should never be cached or indexed.
/admin
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

# An order page carries a private token in its URL.
/order
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer

# Account pages hold a session cookie.
/account
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
